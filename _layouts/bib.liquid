---
---
{%- comment -%} Website shows 2020+ only; pre-2020 entries stay in papers.bib (queryable / archival) but are not rendered. Entries may also opt out with web_show={false}. {%- endcomment -%}
{% assign _web_year = entry.year | plus: 0 %}
{% if _web_year >= 2020 and entry.web_show != "false" %}
{% assign has_preview = false %}
{% if site.enable_publication_thumbnails and entry.preview and page.hide_publication_thumbnails != true %}
  {% assign has_preview = true %}
{% endif %}
{% if has_preview %}
  {% if entry.preview contains '://' %}
    {% assign entry_path = entry.preview %}
  {% else %}
    {% assign entry_path = entry.preview | prepend: '/assets/img/publication_preview/' | prepend: site.baseurl %}
  {% endif %}
{% endif %}
{% assign proceedings = 'inproceedings,incollection' | split: ',' %}
{% assign thesis = 'thesis,mastersthesis,phdthesis' | split: ',' %}
{% if entry.type == 'article' %}
  {% capture entrytype %}<span class="bib-journal">{{ entry.journal }}</span>{% endcapture %}
{% elsif proceedings contains entry.type %}
  {% capture entrytype %}<span class="bib-journal">In {{ entry.booktitle }}</span>{% endcapture %}
{% elsif thesis contains entry.type %}
  {% capture entrytype %}<span class="bib-journal">{{ entry.school }}</span>{% endcapture %}
{% else %}
  {% capture entrytype %}{% endcapture %}
{% endif %}
{% assign entryyear = '' %}
{% if entry.year %}
  {% capture entryyear %}{{ " " }}{{ entry.year }}{% endcapture %}
{% endif %}
{% if entry.location %}
  {% capture entrytype %}{{ entrytype }}{{ ", " }}{{ entry.location }}{% endcapture %}
{% endif %}
{% if entry.additional_info %}
  {% capture entrytype %}{{ entrytype }}{{ entry.additional_info | markdownify | remove: '<p>' | remove: '</p>' }}{% endcapture %}
{% endif %}
{% capture hook_exists %}{% file_exists _includes/hook/bib.liquid %}{% endcapture %}
{% if hook_exists == 'true' %}
  {% include hook/bib.liquid %}
{% endif %}
{% assign entrytype_text = entrytype | strip_html | strip %}

<li class="bib-entry" data-year="{{ entry.year }}" data-category="{{ entry.category }}" data-subcategory="{{ entry.subcategory }}" data-type="{{ entry.publication_type }}" data-clinical="{{ entry.clinical }}" data-basic="{{ entry.basic }}" data-if="{{ entry.impact_factor }}" data-jcr="{{ entry.jcr_quartile }}">
  <div class="bib-row{% unless has_preview %} bib-row--no-preview{% endunless %}">
    {% if has_preview %}
      <div class="bib-thumb">
        <img src="{{ entry_path }}" alt="Image for {{ entry.title }}" loading="lazy">
      </div>
    {% endif %}
    <div class="bib-content">
      <div class="bib-main">
        <h2 class="bib-title">
          {% if entry.doi %}
            <a href="https://doi.org/{{ entry.doi }}">{{ entry.title }}</a>
          {% else %}
            <span>{{ entry.title }}</span>
          {% endif %}
          {% assign citation_count = 0 %}
          {% if site.data.citations[entry.key] %}
            {% assign citation_count = site.data.citations[entry.key].citations %}
          {% endif %}
          {% if citation_count > 0 %}
            <span class="bib-citation-badge" title="{{ citation_count }} citations"><i class="fas fa-quote-right"></i> {{ citation_count }}</span>
          {% endif %}
        </h2>

        <div class="bib-authors">
          {% include bib_authors.liquid entry=entry %}
        </div>

        <div class="bib-meta">
          {{ entrytype }}{% if entrytype_text != "" and entryyear != "" %}.{% endif %}{{ entryyear }}.{% if entry.doi %} <a href="https://doi.org/{{ entry.doi }}">doi:{{ entry.doi }}</a>{% endif %}
        </div>
      </div>

      {% if entry.key %}
        {% assign publication_lang = page.lang | default: 'en' %}
        <div class="bib-actions">
          <a class="bib-link" href="{{ entry.key | prepend: '/bibliography/' | prepend: site.baseurl }}">{{ site.data.i18n[publication_lang].publications.read_more }}</a>
        </div>
      {% endif %}
    </div>
  </div>
</li>
{% endif %}
